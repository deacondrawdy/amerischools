---
import {
  ArrowRight, BookOpen, Bus, CalendarDays, ChevronDown, ChevronRight, FileText,
  GraduationCap, Heart, MapPin, Play, UsersRound,
} from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CampusNav from '../../components/CampusNav.astro';
import GradeTabs from '../../components/GradeTabs.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import PreschoolBanner from '../../components/PreschoolBanner.astro';
import { campuses, directionsHref, site, telHref, type Campus } from '../../data/site';
import type { PhotoKey } from '../../data/photos';
import { findCampusLink, mealMenuLinks, salaryDisclosure } from '../../data/legacy';
import { marked } from 'marked';

export function getStaticPaths() {
  return campuses.map((campus) => ({ params: { slug: campus.slug }, props: { campus } }));
}

const { campus } = Astro.props as { campus: Campus };
const base = `/campuses/${campus.slug}`;
const performanceUrl = findCampusLink(campus.slug, /school performance/i) ?? site.performanceUrl;
const disclosure = salaryDisclosure(campus.slug);
const disclosureHtml = disclosure ? await marked.parse(disclosure) : null;

const quickLinks = [
  { icon: UsersRound, label: 'Meet our teachers', href: `${base}/staff/` },
  { icon: FileText, label: 'View school performance', href: performanceUrl },
  { icon: BookOpen, label: 'Explore our curriculum', href: `${base}/curriculum/` },
];

const highlights: { title: string; body: string; photo: PhotoKey }[] = [
  { title: 'Project-based learning', body: 'Students explore questions and develop solutions.', photo: 'phoenixBuildingProject' },
  { title: 'Skill-based instruction', body: "Teaching responds to students' developing skills.", photo: 'phoenixBoyWriting' },
  { title: 'Kindness in practice', body: 'Respect, responsibility, and care for others.', photo: 'tucsonFoodDrive' },
];

// Answers come from the campus's migrated pages and documents.
type FamilyLink = { label: string; href: string };
const menuLinks: FamilyLink[] = mealMenuLinks(campus.slug);
const handbook = findCampusLink(campus.slug, /student handbook/i);
const familyInfo: { icon: typeof CalendarDays; title: string; body: string; links: FamilyLink[] }[] = [
  {
    icon: CalendarDays,
    title: 'School hours & calendar',
    body: `The ${campus.name} school-year calendar, with holidays and family events.`,
    links: [{ label: 'Campus calendar', href: `${base}/calendar/` }],
  },
  {
    icon: UsersRound,
    title: 'Before & after school care',
    body: 'Supervised care, clubs, and sports for students before and after the school day.',
    links: [
      { label: 'Before & after school programs', href: `${base}/before-and-after-school/` },
      { label: 'Clubs & sports', href: `${base}/clubs-and-sports/` },
    ],
  },
  {
    icon: Bus,
    title: 'Transportation & meals',
    body: 'Breakfast and lunch menus, plus drop-off and pick-up details from the campus office.',
    links: [...(menuLinks.length ? menuLinks : [{ label: 'Menus for all campuses', href: site.currentFamiliesUrl }]), { label: 'Contact the campus office', href: `${base}/contact/` }],
  },
  {
    icon: Heart,
    title: 'Enrollment & student support',
    body: 'How to enroll, the student handbook, and who to contact with questions.',
    links: [
      { label: 'Enroll', href: '/admissions/' },
      ...(handbook ? [{ label: 'Student handbook', href: handbook }] : []),
      { label: 'Staff & admin', href: `${base}/staff/` },
    ],
  },
];
---
<BaseLayout
  title={`${campus.name} Campus | ${site.name}`}
  description={`Tuition-free ${campus.grades} charter school in ${campus.city}, Arizona. ${campus.intro}`}
  campus={campus}
>
  <CampusNav campus={campus} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-y-0 right-0 hidden w-[60%] lg:block">
      <ImageSlot photo={campus.heroPhoto} loading="eager" sizes="(min-width: 1024px) 60vw, 100vw" />
      <div class="absolute inset-0 bg-gradient-to-r from-white via-white/30 to-transparent"></div>
      <button type="button" class="absolute right-6 bottom-6 flex items-center gap-3 rounded-full bg-navy-950/70 py-2 pr-5 pl-2 text-sm font-semibold text-white backdrop-blur-sm hover:bg-navy-950/85">
        <span class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-white"><Play class="h-4 w-4 fill-white" aria-hidden="true" /></span>
        Explore our {campus.name} campus
      </button>
    </div>
    <div class="container-site relative py-6 lg:py-8">
      <nav aria-label="Breadcrumb">
        <ol class="flex gap-2 text-sm text-muted">
          <li><a href="/" class="hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/campuses/" class="hover:underline">Campuses</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{campus.name}</li>
        </ol>
      </nav>
      <div class="max-w-xl pt-6 pb-4 lg:pt-8">
        <p class="eyebrow">Tuition-free {campus.grades} charter school in {campus.city}</p>
        <h1 class="mt-3 text-4xl leading-[1.05] font-bold sm:text-5xl lg:text-[3.4rem]">
          {campus.headline[0]}<br />{campus.headline[1]}
        </h1>
        <p class="mt-4 text-lg text-muted sm:text-xl">{campus.intro}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={`/visit/?campus=${campus.slug}`} class="btn-primary">Request a Tour</a>
          <a href={site.applyUrl} class="btn-outline">Apply</a>
        </div>
        <p class="mt-4 text-lg">Questions? Call <a href={telHref(campus.phone)} class="font-semibold text-brand-700 hover:underline">{campus.phone}</a></p>
        <div class="mt-8 aspect-[4/3] overflow-hidden rounded-lg lg:hidden">
          <ImageSlot photo={campus.heroPhoto} sizes="100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Info strip -->
  <div class="bg-navy-900 text-white">
    <ul class="container-site flex flex-col gap-3 py-4 text-[15px] md:flex-row md:items-center md:justify-between md:gap-6">
      <li class="flex items-center gap-3"><GraduationCap class="h-6 w-6" aria-hidden="true" />Grades {campus.grades}</li>
      <li class="flex items-center gap-3"><UsersRound class="h-6 w-6" aria-hidden="true" />Tuition-free</li>
      <li class="flex items-center gap-3"><MapPin class="h-6 w-6" aria-hidden="true" />{campus.street}, {campus.cityStateZip}</li>
      <li>
        <a href={directionsHref(campus)} class="flex items-center gap-2 font-semibold text-sun-400 hover:underline" target="_blank" rel="noopener">
          Get Directions <ArrowRight class="h-4 w-4" aria-hidden="true" /><span class="sr-only">(opens Google Maps)</span>
        </a>
      </li>
    </ul>
  </div>

  <!-- Quick links -->
  <nav aria-label={`${campus.name} resources`} class="border-b border-line">
    <ul class="container-site grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
      {quickLinks.map(({ icon: Icon, label, href }) => (
        <li>
          <a href={href} class="group flex items-center gap-3 py-5 text-lg text-brand-700 md:justify-center">
            <Icon class="h-7 w-7 shrink-0" aria-hidden="true" /> {label}
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- What learning looks like -->
  <section class="bg-slate-50 py-12" aria-labelledby="learning-heading">
    <div class="container-site">
      <h2 id="learning-heading" class="text-3xl font-bold sm:text-4xl">What learning looks like here.</h2>
      <ul class="mt-6 grid gap-5 md:grid-cols-3">
        {highlights.map((h) => (
          <li class="card group relative">
            <div class="aspect-[16/9] overflow-hidden"><ImageSlot photo={h.photo} sizes="(min-width: 768px) 33vw, 100vw" /></div>
            <div class="flex items-center gap-3 p-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold">
                  <a href={site.approachUrl} class="after:absolute after:inset-0">{h.title}</a>
                </h3>
                <p class="mt-1 text-muted">{h.body}</p>
              </div>
              <ChevronRight class="h-5 w-5 shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <GradeTabs campus={campus} />

  <!-- Family info -->
  <section class="py-12" aria-labelledby="family-heading">
    <div class="container-site">
      <h2 id="family-heading" class="text-3xl font-bold sm:text-4xl">Make school work for your family.</h2>
      <div class="mt-6 grid gap-3 md:grid-cols-2">
        {familyInfo.map(({ icon: Icon, title, body, links }) => (
          <details class="group rounded-md border border-line bg-white shadow-sm">
            <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-3.5 [&::-webkit-details-marker]:hidden">
              <Icon class="h-6 w-6 shrink-0 text-navy-900" aria-hidden="true" />
              <span class="flex-1 font-medium">{title}</span>
              <ChevronDown class="h-5 w-5 transition-transform group-open:rotate-180" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-4 pl-15 text-muted">
              <p>{body}</p>
              <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
                {links.map((l) => (
                  <li>
                    <a href={l.href} class="link-arrow text-sm" {...(l.href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener' } : {})}>
                      {l.label} <ArrowRight class="h-4 w-4" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Visit CTA -->
  <section class="relative overflow-hidden bg-sky-100" aria-labelledby="visit-heading">
    <div class="absolute inset-y-0 right-0 hidden w-1/2 md:block">
      <ImageSlot photo="playground" sizes="50vw" />
      <div class="absolute inset-0 bg-gradient-to-r from-sky-100 to-transparent"></div>
    </div>
    <div class="container-site relative py-10">
      <h2 id="visit-heading" class="text-3xl font-bold sm:text-4xl">Come see the difference for yourself.</h2>
      <p class="mt-2 max-w-md text-lg text-muted">Meet our team, explore the campus, and ask the questions that matter to your family.</p>
      <div class="mt-5 flex flex-wrap items-center gap-5">
        <a href={`/visit/?campus=${campus.slug}`} class="btn-primary">Request a {campus.name} Tour</a>
        <p class="text-sm">
          Our team will confirm your visit.<br />
          Questions? Call <a href={telHref(campus.phone)} class="font-semibold text-brand-700 hover:underline">{campus.phone}</a>
        </p>
      </div>
    </div>
  </section>

  {disclosureHtml && (
    <section aria-label="Required disclosures" class="border-t border-line bg-slate-50">
      <div class="container-site prose prose-sm max-w-4xl py-8 text-muted prose-headings:text-base prose-headings:text-ink prose-strong:text-ink" set:html={disclosureHtml} />
    </section>
  )}

  <PreschoolBanner />
</BaseLayout>

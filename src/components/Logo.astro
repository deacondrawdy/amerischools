---
import { Image } from 'astro:assets';
import seal from '../assets/amerischools-seal.png';

interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---
<a href="/" class="flex items-center gap-3" aria-label="AmeriSchools Academy home">
  <Image
    src={seal}
    alt=""
    widths={[56, 112, 168]}
    sizes="(min-width: 640px) 56px, 48px"
    class="h-12 w-12 shrink-0 sm:h-14 sm:w-14"
    loading="eager"
  />
  <span
    class:list={[
      'font-display text-xl leading-[1.05] font-semibold sm:text-2xl',
      inverse ? 'text-white' : 'text-navy-900',
    ]}
  >
    AmeriSchools<br />Academy
  </span>
</a>

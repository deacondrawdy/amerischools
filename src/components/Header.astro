---
import { ChevronDown, Menu, X } from '@lucide/astro';
import Logo from './Logo.astro';
import { isExternal, mainNav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !isExternal(href) && !href.includes('#') && path.startsWith(href);
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-site flex h-20 items-center justify-between gap-6">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[15px] font-medium text-ink">
        {mainNav.map((item, i) => (
          <li class="relative">
            {item.children ? (
              <>
                <button
                  type="button"
                  class="flex items-center gap-1 py-2 hover:text-brand-700 aria-expanded:text-brand-700"
                  data-disclosure
                  aria-expanded="false"
                  aria-controls={`nav-menu-${i}`}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <ChevronDown class="h-4 w-4 transition-transform [[aria-expanded=true]>&]:rotate-180" aria-hidden="true" />
                </button>
                <ul
                  id={`nav-menu-${i}`}
                  hidden
                  data-disclosure-panel
                  class="absolute top-full left-1/2 mt-2 w-60 -translate-x-1/2 rounded-lg border border-line bg-white p-2 shadow-lg"
                >
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} {...ext(c.href)} class="block rounded-md px-3 py-2 hover:bg-sky-50 hover:text-brand-700">
                        {c.label}
                        {isExternal(c.href) && <span class="sr-only"> (opens in a new tab)</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="py-2 hover:text-brand-700" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={site.currentFamiliesUrl} class="text-sm font-medium text-brand-700 hover:underline">Current Families</a>
      <span class="h-5 w-px bg-line" aria-hidden="true"></span>
      <a href="/es/" lang="es" hreflang="es" class="text-sm font-medium text-brand-700 hover:underline">Español</a>
      <a href={site.applyUrl} class="ml-2 rounded-md border-2 border-brand-600 px-5 py-2 font-display text-lg font-semibold text-brand-700 hover:bg-sky-50">
        Apply
      </a>
    </div>

    <button
      type="button"
      class="rounded-md p-2 text-navy-900 lg:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <Menu class="h-7 w-7" data-icon-open aria-hidden="true" />
      <X class="hidden h-7 w-7" data-icon-close aria-hidden="true" />
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="hidden max-h-[calc(100vh-5rem)] overflow-y-auto border-t border-line bg-white lg:hidden">
    <ul class="container-site flex flex-col py-3 text-lg font-medium">
      {mainNav.map((item) =>
        item.children ? (
          <li>
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-3 [&::-webkit-details-marker]:hidden">
                {item.label}
                <ChevronDown class="h-5 w-5 transition-transform group-open:rotate-180" aria-hidden="true" />
              </summary>
              <ul class="mb-2 border-l-2 border-sky-200 pl-4 text-base">
                {item.children.map((c) => (
                  <li><a href={c.href} {...ext(c.href)} class="block py-2">{c.label}</a></li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li><a href={item.href} class="block py-3">{item.label}</a></li>
        ),
      )}
      <li><a href={site.currentFamiliesUrl} class="block py-3 text-brand-700">Current Families</a></li>
      <li><a href="/es/" lang="es" hreflang="es" class="block py-3 text-brand-700">Español</a></li>
      <li class="py-3"><a href={site.applyUrl} class="btn-primary w-full">Apply</a></li>
    </ul>
  </nav>
</header>

<script>
  import '../scripts/disclosure';

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    panel?.classList.toggle('hidden', !open);
    toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
  });
</script>

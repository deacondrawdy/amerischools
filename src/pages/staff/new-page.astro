---
import { ArrowLeft } from '@lucide/astro';
import StaffLayout from '../../layouts/StaffLayout.astro';
import { isStaff } from '../../lib/staff/session';

if (!isStaff(Astro.cookies)) return Astro.redirect('/staff/');
---
<StaffLayout title="New page" signedIn>
  <a href="/staff/#pages" class="inline-flex items-center gap-1 text-brand-700 hover:underline"><ArrowLeft class="h-4 w-4" aria-hidden="true" />All pages</a>
  <section class="mt-3 max-w-2xl rounded-2xl border border-line bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-bold">Add a new page</h1>
    <p class="mt-1 text-muted">For an event, a program or an announcement that needs its own page. You'll write its text on the next screen.</p>
    <form method="post" action="/staff/api/page-create/" class="mt-6 space-y-4">
      <input type="hidden" name="back" value="/staff/new-page/" />
      <label class="block"><span class="staff-label">Page title</span>
        <input class="staff-input" name="title" maxlength="150" required placeholder="Summer Reading Program" />
      </label>
      <label class="block"><span class="staff-label">Web address (optional)</span>
        <input class="staff-input" name="slug" maxlength="150" placeholder="summer-reading" />
        <span class="staff-hint">Lowercase words joined by dashes. Left empty, it's made from the title: amerischools.org/summer-reading-program/</span>
      </label>
      <button class="staff-btn">Create page</button>
    </form>
    <p class="mt-6 text-sm text-muted">New pages aren't added to the menu automatically. Link to them from another page, the announcement bar, or ask your web developer to add a menu item.</p>
  </section>
</StaffLayout>

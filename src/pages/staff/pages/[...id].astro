---
// Edit one page's title, search description and text (Markdown), with a live preview.
import { ArrowLeft, ExternalLink, RotateCcw, Trash2 } from '@lucide/astro';
import StaffLayout from '../../../layouts/StaffLayout.astro';
import { findPage } from '../../../lib/pages';
import { isStaff } from '../../../lib/staff/session';
import { getStore } from '../../../lib/staff/store';

if (!isStaff(Astro.cookies)) return Astro.redirect('/staff/');
const id = (Astro.params.id ?? '').replace(/\/+$/, '');
const page = await findPage(id);
if (!page) return Astro.redirect(`/staff/?err=${encodeURIComponent('That page no longer exists.')}`);
const edit = getStore().pages[id];
// The original Markdown, as migrated from the old site (frontmatter removed).
const original = page.entry?.body ?? '';
const markdown = edit?.markdown ?? original;
const back = `/staff/pages/${id}/`;
---
<StaffLayout title={`Edit: ${page.title}`} signedIn>
  <a href="/staff/#pages" class="inline-flex items-center gap-1 text-brand-700 hover:underline"><ArrowLeft class="h-4 w-4" aria-hidden="true" />All pages</a>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold">{page.title}</h1>
      <p class="mt-1 text-muted">Address: <a href={`/${id}/`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-brand-700 hover:underline">/{id}/<ExternalLink class="h-4 w-4" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span></a></p>
    </div>
    <div class="flex flex-wrap gap-3">
      {edit && !page.custom && (
        <form method="post" action="/staff/api/page-revert/" data-confirm="Put back the original text? Your edits to this page will be removed.">
          <input type="hidden" name="back" value={back} />
          <input type="hidden" name="id" value={id} />
          <button class="staff-btn-quiet"><RotateCcw class="h-4 w-4" aria-hidden="true" />Put the original text back</button>
        </form>
      )}
      {page.custom && (
        <form method="post" action="/staff/api/page-delete/" data-confirm="Delete this page? Anyone who follows a link to it will see a 'page not found' message.">
          <input type="hidden" name="back" value="/staff/" />
          <input type="hidden" name="id" value={id} />
          <button class="staff-btn-quiet text-red-700"><Trash2 class="h-4 w-4" aria-hidden="true" />Delete page</button>
        </form>
      )}
    </div>
  </div>

  <form method="post" action="/staff/api/page-save/" class="mt-6 grid gap-6 xl:grid-cols-2">
    <input type="hidden" name="back" value={back} />
    <input type="hidden" name="id" value={id} />
    <div class="space-y-4">
      <label class="block"><span class="staff-label">Page title</span>
        <input class="staff-input" name="title" maxlength="150" value={edit?.title ?? page.title} required />
      </label>
      <label class="block"><span class="staff-label">Search description (optional)</span>
        <input class="staff-input" name="description" maxlength="300" value={edit?.description ?? ''} placeholder="One or two sentences Google can show under the page title." />
      </label>
      <label class="block"><span class="staff-label">Page text</span>
        <textarea class="staff-input font-mono text-sm" name="markdown" rows="24" data-markdown>{markdown}</textarea>
        <span class="staff-hint">
          Formatting: <code>## Heading</code>, <code>**bold**</code>, <code>- list item</code>, <code>[link text](/address/)</code>.
          To link a PDF, upload it under PDFs and copy its address. See the <a href="/staff/help/#formatting" class="underline">how-to guide</a>.
        </span>
      </label>
      <button class="staff-btn">Save page</button>
    </div>
    <div>
      <p class="staff-label">Preview</p>
      <div class="prose max-w-none rounded-xl border border-line bg-white p-6 prose-headings:font-display prose-a:text-brand-700" data-preview aria-live="polite"></div>
    </div>
  </form>
</StaffLayout>

<script>
  import { marked } from 'marked';
  const area = document.querySelector<HTMLTextAreaElement>('[data-markdown]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const draw = () => {
    if (area && preview) preview.innerHTML = marked.parse(area.value, { async: false }) as string;
  };
  area?.addEventListener('input', draw);
  draw();
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm)) e.preventDefault();
    }),
  );
</script>

---
// Campus contact page: contact cards, live office-open status, hours and a map.
// Details live in src/data/contact.ts (fax, Facebook, hours) and src/data/site.ts (address, phone).
import { ArrowRight, CalendarClock, Clock, MapPin, Phone, Printer, Sun, ThumbsUp } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CampusNav from '../../../components/CampusNav.astro';
import Reveal from '../../../components/Reveal.astro';
import { campuses, directionsHref, site, telHref, type Campus } from '../../../data/site';
import { contact, type CampusContact } from '../../../data/contact';
import { noWidow } from '../../../lib/text';

const found = campuses.find((c) => c.slug === Astro.params.slug && contact[c.slug]);
if (!found) return Astro.rewrite('/404/');
const campus: Campus = found;
const info: CampusContact = contact[campus.slug];
const base = `/campuses/${campus.slug}`;
const address = `${campus.street}, ${campus.cityStateZip}`;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`AmeriSchools Academy, ${address}`)}&z=15&output=embed`;

const cards = [
  { icon: MapPin, label: 'Visit', value: [campus.street, campus.cityStateZip], href: directionsHref(campus), action: 'Get directions', external: true },
  { icon: Phone, label: 'Call', value: [campus.phone], href: telHref(campus.phone), action: 'Call the office', external: false },
  { icon: Printer, label: 'Fax', value: [info.fax], href: null, action: null, external: false },
  { icon: ThumbsUp, label: 'Follow', value: [info.facebook.label], href: info.facebook.href, action: 'Open Facebook', external: true },
];
---
<BaseLayout
  title={`Contact ${campus.name} | ${site.name}`}
  description={`Address, phone, fax and school hours for AmeriSchools Academy ${campus.name}, ${campus.cityStateZip}.`}
  campus={campus}
>
  <Reveal />
  <CampusNav campus={campus} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-sky-50">
    <div aria-hidden="true" class="blob absolute -top-24 -right-24 h-80 w-80 rounded-full bg-sun-400/25 blur-3xl"></div>
    <div class="container-site relative py-6 lg:py-8">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap gap-2 text-sm text-muted">
          <li><a href="/" class="hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/campuses/" class="hover:underline">Campuses</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${base}/`} class="hover:underline">{campus.name}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">Contact</li>
        </ol>
      </nav>
      <div class="py-8 text-center lg:py-12">
        <p data-reveal class="eyebrow">{campus.name} campus · Grades {campus.grades}</p>
        <h1 data-reveal style="--d:80ms" class="mt-3 text-4xl font-bold sm:text-5xl lg:text-6xl">Contact {campus.name}</h1>
        <p data-reveal style="--d:160ms" class="mx-auto mt-4 max-w-2xl text-lg text-muted sm:text-xl">
          {noWidow('Call the office, stop by, or connect with us online. AmeriSchools Academy offers activities and study programs before and after school each day.')}
        </p>
        <!-- Live office status (filled in by script using Arizona time). -->
        <p data-reveal style="--d:240ms" class="mt-6" aria-live="polite">
          <span data-office-status class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-navy-900 shadow-sm">
            <Clock class="h-4 w-4 text-brand-600" aria-hidden="true" />Office hours: {info.officeHours}
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- Contact cards -->
  <section class="relative -mt-2 pb-4" aria-label="Ways to reach us">
    <div class="container-site">
      <ul class="mx-auto -mt-0 grid max-w-6xl gap-4 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        {cards.map(({ icon: Icon, label, value, href, action, external }, i) => {
          const Tag = href ? 'a' : 'div';
          return (
            <li data-reveal style={`--d:${i * 90}ms`}>
              <Tag
                {...(href ? { href, ...(external ? { target: '_blank', rel: 'noopener' } : {}) } : {})}
                class:list={['lift group flex h-full flex-col items-center rounded-2xl border border-line bg-white p-6 text-center shadow-sm', { 'hover:border-brand-500': href }]}
              >
                <span class="grid h-14 w-14 place-items-center rounded-full bg-sky-50 text-brand-600 transition-colors group-hover:bg-brand-600 group-hover:text-white">
                  <Icon class="h-6 w-6" aria-hidden="true" />
                </span>
                <span class="mt-4 text-xs font-semibold tracking-[0.18em] text-muted uppercase">{label}</span>
                <span class="mt-1 font-display text-lg leading-snug font-semibold text-ink">
                  {value.map((v) => <span class="block">{v}</span>)}
                </span>
                {action && (
                  <span class="mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-brand-700">
                    {action}<ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                    {external && <span class="sr-only">(opens in a new tab)</span>}
                  </span>
                )}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Hours + map -->
  <section class="py-14 lg:py-20" aria-labelledby="hours-heading">
    <div class="container-site">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-2 lg:gap-10">
      <div>
        <h2 id="hours-heading" data-reveal class="text-3xl font-bold sm:text-4xl">School &amp; office hours</h2>
        <div class="mt-6 space-y-4">
          {info.schoolHours.map((g, i) => (
            <div data-reveal style={`--d:${i * 90}ms`} class="flex items-start gap-4 rounded-2xl border border-line bg-white p-5 shadow-sm">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-600 text-white"><Clock class="h-5 w-5" aria-hidden="true" /></span>
              <div>
                <h3 class="text-lg font-bold">{g.label}</h3>
                {g.times.map((t) => <p class="text-muted">{t}</p>)}
              </div>
            </div>
          ))}
          <div class="grid gap-4 sm:grid-cols-3">
            {[
              { icon: CalendarClock, title: 'Half days', body: info.halfDays },
              { icon: Clock, title: 'Office', body: info.officeHours },
              { icon: Sun, title: 'Summer office', body: info.summerOfficeHours },
            ].map(({ icon: Icon, title, body }, i) => (
              <div data-reveal style={`--d:${i * 90}ms`} class="rounded-2xl bg-sky-50 p-5">
                <Icon class="h-5 w-5 text-brand-600" aria-hidden="true" />
                <h3 class="mt-2 font-bold">{title}</h3>
                <p class="mt-1 text-sm text-muted">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div data-reveal style="--d:120ms" class="relative min-h-80 overflow-hidden rounded-2xl border border-line bg-sky-50 shadow-sm lg:min-h-full">
        <iframe
          src={mapSrc}
          title={`Map showing AmeriSchools Academy ${campus.name} at ${address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="absolute inset-0 h-full w-full border-0"
        ></iframe>
        <a
          href={directionsHref(campus)}
          target="_blank"
          rel="noopener"
          class="absolute right-4 bottom-4 left-4 flex items-center justify-between gap-3 rounded-xl bg-white/95 px-5 py-4 shadow-lg backdrop-blur hover:bg-white sm:left-auto"
        >
          <span class="text-sm">
            <span class="block font-semibold text-ink">{campus.street}</span>
            <span class="text-muted">{campus.cityStateZip}</span>
          </span>
          <span class="inline-flex items-center gap-1 text-sm font-semibold whitespace-nowrap text-brand-700">
            Directions <ArrowRight class="h-4 w-4" aria-hidden="true" /><span class="sr-only">(opens in a new tab)</span>
          </span>
        </a>
      </div>
    </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-brand-700 py-14 text-white lg:py-16" aria-labelledby="cta-heading">
    <div class="container-site relative text-center">
      <h2 data-reveal id="cta-heading" class="text-3xl font-bold text-white sm:text-4xl">Come see {campus.name} in person.</h2>
      <div data-reveal style="--d:120ms" class="mt-7 flex flex-wrap justify-center gap-4">
        <a href={`${base}/tours/`} class="btn-primary">Schedule a Tour <ArrowRight class="h-5 w-5" aria-hidden="true" /></a>
        <a href={`${base}/`} class="btn border-2 border-white text-white hover:bg-white/10">Explore the Campus</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes drift { 50% { transform: translate(1.5rem, -1rem) scale(1.08); } }
  @keyframes pulse-dot { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: no-preference) {
    .blob { animation: drift 16s ease-in-out infinite; }
    :global(.status-dot.open) { animation: pulse-dot 1.6s ease-in-out infinite; }
  }
</style>

<script>
  // Show whether the office is open right now. Arizona doesn't observe DST, so America/Phoenix
  // is always correct. Regular hours: 8:00 AM – 4:00 PM, Monday – Friday (holidays not known here).
  const el = document.querySelector<HTMLElement>('[data-office-status]');
  if (el) {
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat('en-US', { timeZone: 'America/Phoenix', weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false })
        .formatToParts(new Date())
        .map((p) => [p.type, p.value]),
    );
    const minutes = (parseInt(parts.hour, 10) % 24) * 60 + parseInt(parts.minute, 10);
    const day = parts.weekday;
    const weekday = !['Sat', 'Sun'].includes(day);
    const open = weekday && minutes >= 8 * 60 && minutes < 16 * 60;
    const next =
      weekday && minutes < 8 * 60 ? 'today' : weekday && day !== 'Fri' ? 'tomorrow' : 'Monday';
    const text = open ? 'Office open now · closes at 4:00 PM' : `Office closed · opens ${next} at 8:00 AM`;
    el.innerHTML = `<span class="status-dot ${open ? 'open' : ''}" style="width:.6rem;height:.6rem;border-radius:9999px;background:${open ? '#16a34a' : '#dc2626'}"></span>${text}`;
  }
</script>

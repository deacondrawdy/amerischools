---
// Hub for current families: district portals plus each campus's everyday resources.
import { ArrowRight, ExternalLink, FileText } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { campuses, portals, site } from '../../data/site';
import { findCampusLink, mealMenuLinks } from '../../data/legacy';
import { noWidow } from '../../lib/text';

const resourceTypes = [
  { label: 'Calendar', find: (slug: string) => `/campuses/${slug}/calendar/` },
  { label: 'Student handbook', find: (slug: string) => findCampusLink(slug, /student handbook/i) },
  { label: 'Dress code', find: (slug: string) => findCampusLink(slug, /dress code/i) },
  { label: 'School supplies', find: (slug: string) => findCampusLink(slug, /supplies/i) },
  { label: 'Before & after school', find: (slug: string) => `/campuses/${slug}/before-and-after-school/` },
  { label: 'Staff & admin', find: (slug: string) => `/campuses/${slug}/staff/` },
];
const campusResources = campuses.map((c) => {
  const seen = new Set<string>();
  const links = [
    ...resourceTypes.slice(0, 1).map((r) => ({ label: r.label, href: r.find(c.slug) })),
    ...mealMenuLinks(c.slug),
    ...resourceTypes.slice(1).map((r) => ({ label: r.label, href: r.find(c.slug) })),
  ].filter((l): l is { label: string; href: string } => !!l.href && !seen.has(l.href) && !!seen.add(l.href));
  return { campus: c, links };
});
---
<BaseLayout title={`Current Families | ${site.name}`} description="Portals, calendars, menus, and handbooks for current AmeriSchools families.">
  <section class="bg-sky-50 py-12">
    <div class="container-site">
      <p class="eyebrow">Current families</p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Everything for the school year.</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted">Sign in to family portals, and find your campus calendar, menus, and handbooks.</p>
    </div>
  </section>

  <section class="py-12" aria-labelledby="portals-heading">
    <div class="container-site">
      <h2 id="portals-heading" class="text-2xl font-bold sm:text-3xl">Family &amp; student portals</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {portals.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener" class="card group flex h-full flex-col p-5 hover:border-brand-500">
              <span class="flex items-center justify-between font-display text-lg font-semibold">
                {p.label}
                <ExternalLink class="h-4 w-4 text-muted group-hover:text-brand-700" aria-hidden="true" />
              </span>
              <span class="mt-1 text-sm text-muted">{p.note}</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-slate-50 py-12" aria-labelledby="campus-res-heading">
    <div class="container-site">
      <h2 id="campus-res-heading" class="text-2xl font-bold sm:text-3xl">Campus resources</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {campusResources.map(({ campus, links }) => (
          <section class="card p-6" aria-labelledby={`res-${campus.slug}`}>
            <h3 id={`res-${campus.slug}`} class="text-xl font-semibold">
              <a href={`/campuses/${campus.slug}/`} class="hover:text-brand-700">{campus.name}</a>
              <span class="ml-2 text-sm font-normal text-muted">{campus.grades}</span>
            </h3>
            <ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
              {links.map((l) => {
                const pdf = l.href.endsWith('.pdf');
                return (
                  <li>
                    <a href={l.href} class="link-arrow text-[15px]" {...(pdf ? { target: '_blank', rel: 'noopener' } : {})}>
                      {pdf ? <FileText class="h-4 w-4" aria-hidden="true" /> : <ArrowRight class="h-4 w-4" aria-hidden="true" />}
                      {noWidow(l.label)}
                      {pdf && <span class="text-xs font-normal text-muted">PDF</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

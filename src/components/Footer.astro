---
import { MapPin, Phone } from '@lucide/astro';
import Logo from './Logo.astro';
import { campuses, site, telHref, type Campus } from '../data/site';
import { meetingNotice as m, teacherSalary as t } from '../data/notices';

interface Props {
  /** When set, the footer shows this campus's address and phone (campus pages). */
  campus?: Campus;
}
const { campus } = Astro.props;
const links = campus
  ? [
      { label: 'Current Families', href: site.currentFamiliesUrl },
      { label: 'Contact', href: '/contact/' },
      { label: 'Accessibility', href: '/accessibility/' },
    ]
  : [
      { label: 'Current Families', href: site.currentFamiliesUrl },
      { label: 'District Information', href: '/district-information/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Accessibility', href: '/accessibility/' },
    ];
---
<footer class="bg-navy-900 text-white">
  <div class="container-site flex flex-col gap-8 py-10 md:flex-row md:items-center md:gap-10">
    <Logo inverse />

    {campus && (
      <div class="flex flex-col gap-6 text-sm md:flex-row md:items-center md:gap-10 md:border-l md:border-white/20 md:pl-10">
        <p class="flex items-start gap-3">
          <MapPin class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
          <span>{campus.street}<br />{campus.cityStateZip}</span>
        </p>
        <a href={telHref(campus.phone)} class="flex items-center gap-3 text-base hover:underline">
          <Phone class="h-5 w-5" aria-hidden="true" />{campus.phone}
        </a>
      </div>
    )}
    {!campus && (
      <ul aria-label="Campus phone numbers" class="flex flex-wrap gap-x-8 gap-y-3 text-sm md:border-l md:border-white/20 md:pl-10 2xl:gap-10">
        {campuses.map((c) => (
          <li>
            <span class="block text-white/70">{c.name}</span>
            <a href={telHref(c.phone)} class="flex items-center gap-2 text-base font-medium whitespace-nowrap hover:underline">
              <Phone class="h-4 w-4 shrink-0" aria-hidden="true" />{c.phone}
            </a>
          </li>
        ))}
      </ul>
    )}

    <nav aria-label="Footer" class="md:ml-auto md:border-l md:border-white/20 md:pl-10">
      <ul class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm">
        {links.map((l) => <li><a href={l.href} class="whitespace-nowrap hover:underline">{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <section aria-labelledby="public-notices-heading" class="border-t border-white/10">
    <div class="container-site grid gap-6 py-8 text-sm leading-relaxed text-white/80 lg:grid-cols-[3fr_2fr] lg:gap-12">
      <h2 id="public-notices-heading" class="sr-only">Public notices</h2>
      <div>
        <h3 class="font-sans text-xs font-semibold tracking-[0.14em] text-white uppercase">Meeting notice policy</h3>
        <p class="mt-2">
          Pursuant to {m.statute}, {m.board} hereby states that all notices of the meetings of {m.board} will be
          posted at {m.postingLocation} and on our website
          (<a href={m.websiteHref} class="underline underline-offset-2 hover:text-white">{m.websiteLabel}</a>).
          The location is open to the public {m.publicHours}. Such notices will indicate the date, time and place of
          the meeting and will include an agenda or information concerning the manner in which the public may obtain
          an agenda for the meeting.
        </p>
      </div>
      <div>
        <h3 class="font-sans text-xs font-semibold tracking-[0.14em] text-white uppercase">Average teacher salary ({t.statute})</h3>
        <ul class="mt-2 space-y-1">
          <li>Average salary of all teachers employed in the budget year {t.budgetYear}: {t.budgetYearAverage}</li>
          <li>Average salary of all teachers employed in the prior year {t.priorYear}: {t.priorYearAverage}</li>
          <li>Increase in average teacher salary from the prior year {t.priorYear} {t.increase}. Percentage increase: {t.percentIncrease}</li>
        </ul>
      </div>
    </div>
  </section>
  <p class="border-t border-white/10 py-4 text-center text-xs text-white/70">
    © {new Date().getFullYear()} {site.name}. Tuition-free public charter schools in Arizona.
  </p>
</footer>

---
import {
  ArrowRight, BookOpen, ChartColumn, MessageCircle, Play, UsersRound,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CampusFinder from '../components/CampusFinder.astro';
import CampusCard from '../components/CampusCard.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PreschoolBanner from '../components/PreschoolBanner.astro';
import { campuses } from '../data/site';

const quickLinks = [
  { icon: BookOpen, title: 'How we teach', sub: 'Skill-based learning in action', href: '/our-approach/' },
  { icon: UsersRound, title: 'Meet our educators', sub: 'Caring experts, real impact', href: '/about/teachers/' },
  { icon: ChartColumn, title: 'School performance', sub: 'How we support student growth', href: '/about/performance/' },
];

const pillars = [
  { n: '01', title: 'Skill-based instruction', body: 'Learning groups respond to developing skills.', alt: 'A student writing at her desk' },
  { n: '02', title: 'Learning beyond the classroom', body: 'Connect classroom ideas with the wider community.', alt: 'Students building a robotics project' },
  { n: '03', title: 'Relationships that support learning', body: 'Students, teachers, and families work together.', alt: 'A teacher working one-on-one with a student' },
];

const visitLinks = [
  { icon: BookOpen, label: 'Curriculum', href: '/our-approach/curriculum/' },
  { icon: UsersRound, label: 'Teachers', href: '/about/teachers/' },
  { icon: MessageCircle, label: 'Family questions', href: '/admissions/faq/' },
];
---
<BaseLayout
  title="AmeriSchools Academy | Tuition-Free K–8 Charter Schools in Arizona"
  description="Hands-on, skill-based learning at tuition-free K–8 charter schools in Phoenix, Tucson, and Yuma, Arizona."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-sky-50">
    <div class="absolute inset-y-0 right-0 hidden w-[62%] lg:block">
      <ImageSlot alt="Students and a teacher building a model bridge together" tone="navy" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-sky-50 via-sky-50/40 to-transparent"></div>
      <button type="button" class="absolute bottom-8 left-1/4 flex items-center gap-3 font-display text-lg font-medium text-white drop-shadow">
        <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-white"><Play class="h-5 w-5 fill-white" aria-hidden="true" /></span>
        See learning in action
      </button>
    </div>
    <div class="container-site relative py-12 lg:py-16">
      <div class="max-w-2xl">
        <p class="eyebrow">Tuition-free K–8 charter schools in Arizona</p>
        <h1 class="mt-3 text-4xl leading-[1.05] font-bold sm:text-5xl lg:text-[3.5rem]">
          Hands-on learning.<br />A <span class="text-brand-600">personal path</span> forward.
        </h1>
        <p class="mt-4 text-lg text-muted sm:text-xl">
          Skill-based instruction, real-world exploration, and a connected school community.
        </p>
        <div class="mt-6"><CampusFinder /></div>
      </div>
    </div>
  </section>

  <!-- Quick links bar -->
  <nav aria-label="Learn more" class="bg-navy-900 text-white">
    <ul class="container-site grid divide-y divide-white/15 md:grid-cols-3 md:divide-x md:divide-y-0">
      {quickLinks.map(({ icon: Icon, title, sub, href }) => (
        <li>
          <a href={href} class="group flex items-center gap-4 px-2 py-5 md:justify-center">
            <Icon class="h-9 w-9 shrink-0 text-brand-500" aria-hidden="true" />
            <span>
              <span class="flex items-center gap-2 font-display text-lg font-semibold">
                {title} <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </span>
              <span class="block text-sm text-white/75">{sub}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Our approach -->
  <section class="py-14" aria-labelledby="approach-heading">
    <div class="container-site text-center">
      <p class="eyebrow">Our approach</p>
      <h2 id="approach-heading" class="mt-2 text-3xl font-bold sm:text-4xl">
        An education built around <span class="text-brand-600">growth.</span>
      </h2>
      <ul class="mt-8 grid gap-6 text-left md:grid-cols-3">
        {pillars.map((p) => (
          <li class="card">
            <div class="aspect-[16/9]"><ImageSlot alt={p.alt} /></div>
            <div class="flex gap-4 p-5">
              <span class="border-r border-line pr-4 font-display text-2xl font-semibold text-brand-500" aria-hidden="true">{p.n}</span>
              <div>
                <h3 class="text-lg font-semibold">{p.title}</h3>
                <p class="mt-1 text-muted">{p.body}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <a href="/our-approach/" class="link-arrow mt-6">Explore the AmeriSchools approach <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
    </div>
  </section>

  <!-- Campuses -->
  <section class="bg-sky-50 py-14" aria-labelledby="campuses-heading">
    <div class="container-site">
      <div class="text-center">
        <p class="eyebrow">Our campuses</p>
        <h2 id="campuses-heading" class="mt-2 text-3xl font-bold sm:text-4xl">Find your AmeriSchools community</h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {campuses.map((c) => <li><CampusCard campus={c} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Visit -->
  <section class="bg-sky-50 pb-14" aria-labelledby="visit-heading">
    <div class="container-site grid items-center gap-8 lg:grid-cols-2">
      <div class="aspect-[16/8] overflow-hidden rounded-lg">
        <ImageSlot alt="A teacher reading with two students" />
      </div>
      <div>
        <p class="eyebrow">Get to know us</p>
        <h2 id="visit-heading" class="mt-2 text-3xl leading-tight font-bold sm:text-4xl">See the learning.<br />Meet the people.</h2>
        <p class="mt-3 text-lg text-muted">Explore classrooms, ask about your child's grade, and get to know your campus team.</p>
        <a href="/visit/" class="btn-primary mt-5 py-2 text-base">Plan a Campus Visit</a>
        <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          {visitLinks.map(({ icon: Icon, label, href }) => (
            <li>
              <a href={href} class="link-arrow text-sm">
                <Icon class="h-6 w-6 text-brand-600" aria-hidden="true" /> {label} <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <PreschoolBanner />
</BaseLayout>

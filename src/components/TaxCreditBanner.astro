---
// Arizona public school tax credit banner (above the footer), adapted from the donation
// site's hero design. Built in HTML so text stays readable and accessible at every size.
// Links to the current donation site until it's rebuilt.
import { ArrowRight } from '@lucide/astro';
import ImageSlot from './ImageSlot.astro';
import { site } from '../data/site';

const credits = [
  { amount: '$200', who: 'Single, head of household, or married filing separately' },
  { amount: '$400', who: 'Married filing jointly' },
];
---
<section aria-labelledby="tax-credit-heading" class="border-t-[5px] border-brand-600 bg-sky-50">
  <div class="container-site grid items-center gap-6 py-8 md:grid-cols-[1fr_auto] xl:grid-cols-[auto_1fr_auto_auto] xl:gap-8">
    <div class="hidden h-28 w-28 shrink-0 overflow-hidden rounded-full ring-4 ring-white xl:block">
      <ImageSlot photo="studentsGroup" sizes="112px" />
    </div>

    <div>
      <p class="eyebrow">Arizona public school tax credit</p>
      <h2 id="tax-credit-heading" class="mt-1 text-3xl leading-tight font-bold sm:text-4xl">
        Give students more ways to&nbsp;<span class="relative inline-block text-brand-600">
          shine.
          <svg viewBox="0 0 120 12" preserveAspectRatio="none" class="absolute -bottom-1.5 left-0 h-2.5 w-full" aria-hidden="true">
            <path d="M2 9 C 30 3, 80 2, 118 6" fill="none" stroke="#ffc93c" stroke-width="4" stroke-linecap="round" />
          </svg>
        </span>
      </h2>
      <p class="mt-3 max-w-xl text-muted">
        Help fund qualifying extracurricular programs at AmeriSchools—and you may qualify for an Arizona income tax credit.
      </p>
    </div>

    <ul class="grid grid-cols-2 gap-3 md:w-80" aria-label="Maximum credit">
      {credits.map((c) => (
        <li class="rounded-lg bg-white p-3 ring-1 ring-sky-200">
          <p class="font-display text-brand-700">
            <span class="text-xs font-semibold tracking-wide uppercase">Up to</span>
            <span class="ml-1 text-2xl font-bold">{c.amount}</span>
          </p>
          <p class="mt-1 text-xs leading-snug text-muted">{c.who}</p>
        </li>
      ))}
    </ul>

    <div class="flex flex-col items-start gap-2 md:col-start-2 md:items-center xl:col-start-auto">
      <a href={site.taxCreditUrl} target="_blank" rel="noopener" class="btn-primary w-full whitespace-nowrap sm:w-auto">
        Give today <ArrowRight class="h-5 w-5" aria-hidden="true" />
        <span class="sr-only">(opens the AmeriSchools donation site in a new tab)</span>
      </a>
      <p class="max-w-56 text-xs text-muted md:text-center">
        Credit is nonrefundable and depends on your Arizona income tax liability.
      </p>
    </div>
  </div>
</section>

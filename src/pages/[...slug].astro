---
// Renders every page migrated from the old site (src/content/pages, excluding _legacy/), and
// pages Marketing created at /staff. A page edited at /staff shows the edited Markdown instead.
import { render } from 'astro:content';
import { marked } from 'marked';
import ContentLayout from '../layouts/ContentLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { campuses } from '../data/site';
import { findPage } from '../lib/pages';
import { getStore } from '../lib/staff/store';

const id = (Astro.params.slug ?? '').replace(/\/+$/, '');
const page = id ? await findPage(id) : undefined;
if (!page) return Astro.rewrite('/404/');

const edit = getStore().pages[page.id];
const Content = !edit && page.entry ? (await render(page.entry)).Content : undefined;
const html = edit ? await marked.parse(edit.markdown) : '';
// Old titles repeat the campus name ("Tucson Campus Calendar"); the breadcrumb already says it.
const campusPrefix = /^(Phoenix( Camelback)?|Tucson( Campus)?|(North )?Yuma( North| Middle| South)?)\s+/i;
// Campus tour pages get the HubSpot tour request form under the open-house details.
const tourCampus = page.id.endsWith('/tours') ? campuses.find((c) => c.slug === page.campus) : undefined;
const title = page.campus ? page.title.replace(campusPrefix, '').replace(/^Campus\s+/i, '') : page.title;
---
<ContentLayout title={title} description={edit?.description} campusSlug={page.campus}>
  {Content ? <Content /> : <Fragment set:html={html} />}
  {tourCampus && (
    <section aria-labelledby="tour-form-heading" class="not-prose mt-10">
      <h2 id="tour-form-heading" class="text-3xl font-bold">Request a tour</h2>
      <p class="mt-2 text-muted">Pick a few times that work and our {tourCampus.name} team will confirm your visit.</p>
      <HubSpotForm kind="tour" campus={tourCampus} class="mt-5" />
    </section>
  )}
</ContentLayout>

---
import {
  ArrowRight, BookOpen, ChartColumn, MessageCircle, Play, UsersRound,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CampusFinder from '../components/CampusFinder.astro';
import CampusCard from '../components/CampusCard.astro';
import ImageSlot from '../components/ImageSlot.astro';
import TaxCreditBanner from '../components/TaxCreditBanner.astro';
import VideoDialog from '../components/VideoDialog.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { campuses, site } from '../data/site';
import type { PhotoKey } from '../data/photos';
import { noWidow } from '../lib/text';

// Hero slideshow. The real AmeriSchools photo leads; the two "illustrative" slides are
// AI-generated placeholders from the mockup asset pack — swap for real photos before launch.
const heroSlides: PhotoKey[] = [
  'phoenixGirlsWriting',
  'illustrativeHeroFourStudents',
  'illustrativeStudentLaptop',
  'kinderSlide',
  'yumaNorthRunning',
];

const quickLinks = [
  { icon: BookOpen, title: 'How we teach', sub: 'Skill-based learning in action', href: site.approachUrl },
  { icon: UsersRound, title: 'Meet our educators', sub: 'Caring experts, real impact', href: '/campuses/' },
  { icon: ChartColumn, title: 'School performance', sub: 'How we support student growth', href: site.performanceUrl },
];

const pillars: { n: string; title: string; body: string; photo: PhotoKey }[] = [
  { n: '01', title: 'Skill-based instruction', body: 'Learning groups respond to developing skills.', photo: 'phoenixBoyWriting' },
  { n: '02', title: 'Learning beyond the classroom', body: 'Connect classroom ideas with the wider community.', photo: 'phoenixKayaking' },
  { n: '03', title: 'Relationships that support learning', body: 'Students, teachers, and families work together.', photo: 'teacherHelpingStudents' },
];

const visitLinks = [
  { icon: BookOpen, label: 'Curriculum', href: site.approachUrl },
  { icon: UsersRound, label: 'Teachers', href: '/campuses/' },
  { icon: MessageCircle, label: 'Family questions', href: '/contact/' },
];
---
<BaseLayout
  title="AmeriSchools Academy | Tuition-Free K–8 Charter Schools in Arizona"
  description="Hands-on, skill-based learning at tuition-free K–8 charter schools in Phoenix, Tucson, and Yuma, Arizona."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-sky-50">
    <div class="absolute inset-y-0 right-0 hidden w-[62%] lg:block">
      <HeroCarousel slides={heroSlides} sizes="(min-width: 1024px) 62vw, 100vw" controls="top-right">
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-sky-50 via-sky-50/40 to-transparent"></div>
        <button type="button" data-video-open="learning-video" aria-haspopup="dialog" class="absolute right-8 bottom-8 z-10 flex items-center gap-3 rounded-full bg-navy-950/70 py-2 pr-5 pl-2 font-display text-lg font-medium text-white backdrop-blur-sm hover:bg-navy-950/85">
          <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-white"><Play class="h-5 w-5 fill-white" aria-hidden="true" /></span>
          See learning in action
        </button>
      </HeroCarousel>
    </div>
    <div class="container-site relative py-12 lg:py-16">
      <div class="max-w-2xl 2xl:max-w-3xl">
        <p class="eyebrow">Tuition-free K–8 charter schools in Arizona</p>
        <h1 class="mt-3 text-4xl leading-[1.05] font-bold sm:text-5xl lg:text-[3.5rem] 2xl:text-[4.25rem]">
          <span class="block">Hands-on learning.</span>
          <span class="block">A <span class="text-brand-600">personal path</span>&nbsp;forward.</span>
        </h1>
        <p class="mt-4 text-lg text-muted sm:text-xl 2xl:text-2xl">
          <span class="sm:block">Skill-based instruction, real-world exploration,</span>
          <span class="sm:block">and a connected school community.</span>
        </p>
        <div class="mt-6"><CampusFinder /></div>
        <div class="relative mt-8 aspect-[4/3] overflow-hidden rounded-lg lg:hidden">
          <HeroCarousel slides={heroSlides} sizes="100vw" controls="top-right">
          <button type="button" data-video-open="learning-video" aria-haspopup="dialog" class="absolute bottom-4 left-4 z-10 flex items-center gap-2 rounded-full bg-navy-950/70 py-1.5 pr-4 pl-1.5 font-display font-medium text-white backdrop-blur-sm">
            <span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-white"><Play class="h-4 w-4 fill-white" aria-hidden="true" /></span>
            See learning in action
          </button>
          </HeroCarousel>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick links bar -->
  <nav aria-label="Learn more" class="bg-navy-900 text-white">
    <ul class="container-site grid divide-y divide-white/15 md:grid-cols-3 md:divide-x md:divide-y-0">
      {quickLinks.map(({ icon: Icon, title, sub, href }) => (
        <li>
          <a href={href} class="group flex items-center gap-4 px-2 py-5 md:justify-center">
            <Icon class="h-9 w-9 shrink-0 text-brand-500" aria-hidden="true" />
            <span>
              <span class="flex items-center gap-2 font-display text-lg font-semibold">
                {title} <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </span>
              <span class="block text-sm text-white/75">{sub}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Our approach -->
  <section class="py-14" aria-labelledby="approach-heading">
    <div class="container-site text-center">
      <p class="eyebrow">Our approach</p>
      <h2 id="approach-heading" class="mt-2 text-3xl font-bold sm:text-4xl">
        An education built around <span class="text-brand-600">growth.</span>
      </h2>
      <ul class="mt-8 grid gap-6 text-left lg:grid-cols-3">
        {pillars.map((p) => (
          <li class="card md:max-lg:flex">
            <div class="aspect-[16/9] overflow-hidden md:max-lg:aspect-auto md:max-lg:w-2/5 md:max-lg:shrink-0"><ImageSlot photo={p.photo} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 40vw, 100vw" /></div>
            <div class="flex gap-4 p-5">
              <span class="border-r border-line pr-4 font-display text-2xl font-semibold text-brand-500" aria-hidden="true">{p.n}</span>
              <div>
                <h3 class="text-lg font-semibold">{noWidow(p.title)}</h3>
                <p class="mt-1 text-muted">{noWidow(p.body)}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <a href={site.approachUrl} class="link-arrow mt-6">Explore the AmeriSchools approach <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
    </div>
  </section>

  <!-- Campuses -->
  <section class="bg-sky-50 py-14" aria-labelledby="campuses-heading">
    <div class="container-site">
      <div class="text-center">
        <p class="eyebrow">Our campuses</p>
        <h2 id="campuses-heading" class="mt-2 text-3xl font-bold sm:text-4xl">Find your AmeriSchools community</h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {campuses.map((c) => <li><CampusCard campus={c} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Visit -->
  <section class="bg-sky-50 pb-14" aria-labelledby="visit-heading">
    <div class="container-site grid items-center gap-8 lg:grid-cols-2">
      <div class="aspect-[64/45] overflow-hidden rounded-lg">
        <ImageSlot photo="studentsGroup" sizes="(min-width: 1024px) 50vw, 100vw" />
      </div>
      <div>
        <p class="eyebrow">Get to know us</p>
        <h2 id="visit-heading" class="mt-2 text-3xl leading-tight font-bold sm:text-4xl">See the learning.<br />Meet the people.</h2>
        <p class="mt-3 text-lg text-muted">Explore classrooms, ask about your child's grade, and get to know your campus team.</p>
        <a href="/visit/" class="btn-primary mt-5 py-2 text-base">Plan a Campus Visit</a>
        <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          {visitLinks.map(({ icon: Icon, label, href }) => (
            <li>
              <a href={href} class="link-arrow text-sm">
                <Icon class="h-6 w-6 text-brand-600" aria-hidden="true" /> {label} <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <TaxCreditBanner />

  <VideoDialog
    id="learning-video"
    title="See learning in action at AmeriSchools Academy"
    src="/videos/learning-in-action.mp4"
    poster="/videos/learning-in-action-poster.jpg"
  />
</BaseLayout>

---
// Student interest / inquiry form (HubSpot). Replaces the old page, which only held an embedded form.
import { ArrowLeft, FileText, Phone } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubSpotForm from '../../components/HubSpotForm.astro';
import { campuses, site, telHref } from '../../data/site';
---
<BaseLayout
  title={`Student Interest Form | ${site.name}`}
  description="Interested in enrolling at AmeriSchools Academy? Tell us about your student and a campus enrollment team member will reach out."
>
  <section class="bg-sky-50 py-12 lg:py-16">
    <div class="container-site">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap gap-2 text-sm text-muted">
          <li><a href="/" class="hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/admissions/" class="hover:underline">Admissions</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">Student Interest Form</li>
        </ol>
      </nav>
      <div class="mx-auto mt-6 max-w-3xl text-center">
        <p class="eyebrow">Now enrolling · Tuition-free</p>
        <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Student interest form</h1>
        <p class="mt-3 text-lg text-muted">Tell us a little about your student. A member of the campus enrollment team will contact you with next steps.</p>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16" aria-labelledby="interest-form-heading">
    <div class="container-site grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
      <div>
        <h2 id="interest-form-heading" class="sr-only">Interest form</h2>
        <HubSpotForm kind="inquiry" />
      </div>
      <aside class="space-y-6">
        <div class="card p-6">
          <h2 class="text-xl font-bold">Ready to register?</h2>
          <p class="mt-2 text-muted">Download the registration packet and return it to your campus office.</p>
          <a href="/admissions/" class="link-arrow mt-3"><FileText class="h-4 w-4" aria-hidden="true" />Enrollment steps &amp; packet</a>
        </div>
        <div class="card p-6">
          <h2 class="text-xl font-bold">Questions? Call a campus</h2>
          <ul class="mt-3 space-y-2">
            {campuses.map((c) => (
              <li class="flex flex-wrap justify-between gap-2">
                <span>{c.name}</span>
                <a href={telHref(c.phone)} class="inline-flex items-center gap-1 font-semibold text-brand-700 hover:underline"><Phone class="h-4 w-4" aria-hidden="true" />{c.phone}</a>
              </li>
            ))}
          </ul>
        </div>
        <a href="/admissions/" class="link-arrow text-sm"><ArrowLeft class="h-4 w-4" aria-hidden="true" />Back to Admissions</a>
      </aside>
    </div>
  </section>
</BaseLayout>

---
import { ArrowRight } from '@lucide/astro';
import ImageSlot from './ImageSlot.astro';
import type { Campus } from '../data/site';

interface Props {
  campus: Campus;
}
const { campus } = Astro.props;
---
<article class="card group relative flex flex-col">
  <div class="aspect-[16/9]">
    <ImageSlot alt={`Students at the ${campus.name} campus`} />
  </div>
  <div class="p-4">
    <h3 class="text-lg font-semibold">{campus.name}</h3>
    <p class="text-sm text-muted">{campus.grades}</p>
    <a href={`/campuses/${campus.slug}/`} class="link-arrow mt-2 underline after:absolute after:inset-0">
      Explore Campus<span class="sr-only">: {campus.name}</span>
      <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
    </a>
  </div>
</article>
